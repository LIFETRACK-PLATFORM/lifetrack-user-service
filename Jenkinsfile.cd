pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    IMAGE    = "ghcr.io/lifetrack-platform/user-service"
    VPS      = "95.216.164.54"
    VPS_USER = "ricardo"
  }

  stages {
    stage("Docker Build") {
      steps {
        sh "docker buildx build --builder lifetrack-builder -t ${IMAGE}:latest --load ."
      }
    }

    stage("Docker Push") {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token-userpass', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh "echo ${GH_TOKEN} | docker login ghcr.io -u ${GH_USER} --password-stdin"
          sh "docker push ${IMAGE}:latest"
        }
      }
    }

    stage("Docker Login (VPS)") {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token-userpass', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sshagent(['vps-ssh']) {
            sh """
              ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
                echo ${GH_TOKEN} | docker login ghcr.io -u ${GH_USER} --password-stdin
              '
            """
          }
        }
      }
    }

    stage("Deploy") {
      steps {
        sshagent(['vps-ssh']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
              docker stop user-service || true
              docker rm user-service || true
              docker pull ${IMAGE}:latest
              docker run -d --name user-service \
                --network lifetrack-net \
                --restart unless-stopped \
                --env-file /home/ricardo/lifetrack-infra/envs/user-service.env \
                ${IMAGE}:latest
              docker image prune -f
            '
          """
        }
      }
    }
  }

  post {
    always {
      sh 'docker image prune -af || true'
      sh 'docker buildx prune -af --builder lifetrack-builder || true'
    }
    success {
      echo "Deploy OK - user-service #${env.BUILD_NUMBER}"
    }
    failure {
      echo "Deploy FAILED - user-service #${env.BUILD_NUMBER}"
    }
  }
}
